# Database (PostgreSQL recommended; SQLite fallback works for local development)
POSTGRES_USER=examcoach
POSTGRES_PASSWORD=examcoach_dev_password
POSTGRES_DB=ai_exam_coach
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://examcoach:examcoach_dev_password@localhost:5432/ai_exam_coach

# Backend application
APP_NAME=AI Exam Coach
APP_ENV=development
LOG_LEVEL=INFO
AUTH_MODE=dev_header
LOCAL_DEFAULT_USER_ID=00000000-0000-0000-0000-000000000001
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=10080
RATE_LIMIT_ENABLED=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Private local file storage (relative to backend/ or absolute path; never served publicly)
STORAGE_ROOT=../storage
MAX_UPLOAD_MB=50
MAX_PDF_PAGES=250

# Google Gemini API (required starting M3, or M2 if GeminiVisionOCRAdapter is enabled)
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-2.5-flash
GEMINI_MODEL_STANDARD=gemini-2.5-flash
GEMINI_MODEL_VISION=gemini-2.5-flash

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
